{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/api/*.php",
      "use": "vercel-php@0.9.0"
    },
    {
      "src": "backend/index.php",
      "use": "vercel-php@0.9.0"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
